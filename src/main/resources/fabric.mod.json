{
	"schemaVersion": 1,
	"id": "troupe",
	"version": "${version}",
	"name": "Troupe",
	"description": "Server resources (Lua + UI) that clients download and run on join.",
	"icon": "assets/troupe/icon.png",
	"license": "Apache-2.0",
	"contact": {
		"homepage": "https://github.com/holowebmc/troupe",
		"sources": "https://github.com/holowebmc/troupe",
		"issues": "https://github.com/holowebmc/troupe/issues"
	},
	"environment": "*",
	"entrypoints": {
		"main": ["dev.holoweb.troupe.Troupe"],
		"client": ["dev.holoweb.troupe.TroupeClient"]
	},
	"mixins": ["troupe.mixins.json"],
	"depends": {
		"fabricloader": ">=${loader}",
		"minecraft": "${minecraft}",
		"java": ">=${java}",
		"fabric-api": "*"
	},
	"recommends": {
		"vitrine": ">=0.2.1"
	}
}
